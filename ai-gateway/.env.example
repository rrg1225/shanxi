QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=replace-with-your-qwen-api-key
QWEN_MODEL=qwen3-max
QWEN_SYSTEM_PROMPT=You are a professional academic planning and career development assistant.

EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=replace-with-your-embedding-api-key
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

MILVUS_HOST=replace-with-your-milvus-host
MILVUS_PORT=19530
MILVUS_USERNAME=replace-with-your-milvus-username
MILVUS_PASSWORD=replace-with-your-milvus-password
