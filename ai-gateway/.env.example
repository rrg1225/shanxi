MILVUS_METRIC_TYPE=COSINE

SNOWFLAKE_WORKER_ID=1
SNOWFLAKE_DATACENTER_ID=1

CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRANSFORMERS_NO_ADVISORY_WARNINGS=1
