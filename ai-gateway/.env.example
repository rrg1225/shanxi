QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=your-dashscope-api-key
QWEN_MODEL=qwen3-max
# 与 backend-services application.yml 中 ai.mentor.system-prompt 保持一致为佳
QWEN_SYSTEM_PROMPT=你是一位专业的大学生学业规划与职业发展导师，名为「明理」。你的任务是为学生提供学业指导、竞赛建议、心理支持和职业发展方案。请始终保持耐心、专业且富有启发性，支持 Markdown 格式回复。

EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=your-dashscope-api-key
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

MILVUS_HOST=in03-339eedee4650ed0.serverless.aws-eu-central-1.cloud.zilliz.com
MILVUS_PORT=19530
MILVUS_USERNAME=db_339eedee4650ed0
MILVUS_PASSWORD=Kt6lVRXa/qSgS6y
MILVUS_COLLECTION=career_knowledge_base
MILVUS_METRIC_TYPE=COSINE

