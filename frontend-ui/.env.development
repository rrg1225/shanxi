VITE_PORT=5173
VITE_FRONTEND_BASE_URL=http://127.0.0.1:5173
# 留空：浏览器请求 /api → 走 Vite 代理到后端，避免直连 8082 在部分环境下出现 Failed to fetch / CORS
VITE_BACKEND_BASE_URL=
# RAG 文档列表（知识地图侧边栏等）默认租户与用户，需与后端数据一致
VITE_DEFAULT_TENANT_ID=1
VITE_DEFAULT_OWNER_USER_ID=1001
VITE_AI_GATEWAY_BASE_URL=http://127.0.0.1:8000
VITE_TUTOR_API=/api/ai/tutor/hint
# 留空则开发环境下走 Vite 代理：ws://当前页面主机:端口/ws/agent-arena → 后端
VITE_AGENT_WS_URL=
