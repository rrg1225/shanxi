{
  "name": "frontend-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "gateway": "cd ../ai-gateway && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "health": "python ../scripts/project_health.py",
    "ops:check": "python ../scripts/ops_check.py",
    "ci:local": "npm run health && npm run ops:check && npm run build"
  },
  "dependencies": {
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vueuse/core": "^14.2.1",
    "d3": "^7.9.0",
    "dompurify": "^3.4.11",
    "echarts": "^6.1.0",
    "echarts-gl": "^2.1.0",
    "element-plus": "^2.14.2",
    "marked": "^18.0.5",
    "mermaid": "^11.16.0",
    "pinia": "^3.0.4",
    "three": "^0.185.1",
    "vue": "^3.5.13",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/dompurify": "^3.0.5",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vue-tsc": "^3.3.6"
  },
  "engines": {
    "node": ">=20"
  }
}
